{
  "name": "kritha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:android": "node scripts/build-release.js --platform android",
    "build:aab": "node scripts/build-release.js --platform aab",
    "build:app": "node scripts/build-release.js --platform app",
    "build:ios": "node scripts/build-release.js --platform ios",
    "build:macos": "node scripts/build-release.js --platform macos",
    "build:windows": "node scripts/build-release.js --platform windows",
    "worker:registry:dev": "bunx wrangler dev --config wrangler.registry.toml",
    "worker:registry:deploy": "bunx wrangler deploy --config wrangler.registry.toml",
    "bump:beta": "node scripts/bump.js --beta",
    "bump:release": "node scripts/bump.js --release"
  }
}
